# Mission Planner configuration
SCENE_MODEL_URL=http://localhost:8000/v1
SCENE_MODEL_NAME=nvidia/Cosmos-Reason2-8B
PLANNER_MODEL_URL=http://localhost:8001/v1
PLANNER_MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16
PORT=8080

# HuggingFace token for gated model downloads
HF_TOKEN=your-token-here

# NGC token for gated NVIDIA models
